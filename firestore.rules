rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the caller an admin?
    // Admins are declared in the `admins/{uid}` collection (doc id = user uid).
    // Create that doc manually for the platform owner(s). Never trust client claims.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Admins collection: only admins can read; never writable from the client.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // User profiles: owner can read/update their own profile.
    // Balance / loyalty fields must NEVER be writable from the client — server
    // (edge functions with service role / admin SDK) updates those.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.balance == 0
        && request.resource.data.loyaltyPoints == 0;
      allow update: if isSignedIn() && request.auth.uid == userId
        // Owner cannot mutate sensitive fields client-side.
        && request.resource.data.balance == resource.data.balance
        && request.resource.data.loyaltyPoints == resource.data.loyaltyPoints
        && request.resource.data.loyaltyLevel == resource.data.loyaltyLevel
        && (!('role' in request.resource.data) ||
            request.resource.data.role == resource.data.get('role', null));
      allow delete: if isAdmin();
    }

    // Orders: owner can read their own; only admins can list all.
    // Creates must stamp the caller's uid. Status / delivered come from
    // trusted server-side sync, so owner updates are forbidden client-side.
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Transactions: owner can read their own; writes only from server / admins.
    match /transactions/{transactionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Notifications: broadcast announcements written by admins, readable by
    // any signed-in user.
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Default deny — anything not matched above is locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}